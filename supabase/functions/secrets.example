# Copia estas claves a un archivo local .env que no se suba a Git.
MAIL_DISPATCH_SECRET=GENERA_UN_VALOR_ALEATORIO_DE_32_BYTES
APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec
APPS_SCRIPT_HMAC_SECRET=GENERA_OTRO_VALOR_ALEATORIO_DE_32_BYTES
PUBLIC_APP_URL=https://TU_DOMINIO
MAIL_FROM_NAME=Atencion al Cliente CEPRUNSA

DNI_API_BASE_URL=https://TU_PROVEEDOR/ruta
# Opcional: omite esta variable si el proveedor no requiere Authorization Bearer.
DNI_API_BEARER_TOKEN=TU_TOKEN_BEARER_PRIVADO
DNI_LOOKUP_HASH_SECRET=GENERA_UN_TERCER_VALOR_ALEATORIO_DE_32_BYTES
DNI_API_TIMEOUT_MS=15000
DNI_LOOKUP_DEBUG=false

# Protege los hashes usados para limitar el endpoint publico de encuestas.
PUBLIC_SURVEY_HASH_SECRET=GENERA_UN_CUARTO_VALOR_ALEATORIO_DE_32_BYTES
