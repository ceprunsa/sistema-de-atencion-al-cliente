{
  "manifest_version": 3,
  "name": "CEPRUNSA - Registro de correo en RAC",
  "version": "0.4.3",
  "description": "Transfiere temporalmente un correo visible de Gmail al formulario RAC.",
  "icons": {
    "16": "ceprunsa_ico.png",
    "32": "ceprunsa_ico.png",
    "48": "ceprunsa_ico.png",
    "128": "ceprunsa_ico.png"
  },
  "permissions": ["storage", "alarms"],
  "action": { "default_title": "RAC Gmail — Producción" },
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail-adapter.js", "content/gmail-content.js"],
      "css": ["content/gmail.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sistema-de-atencion-al-cliente.vercel.app/*"],
      "js": ["content/rac-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
