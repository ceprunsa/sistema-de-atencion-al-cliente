{
  "manifest_version": 3,
  "name": "CEPRUNSA - Registro de correo en RAC (Local)",
  "version": "0.4.3",
  "description": "Configuración local del puente temporal hacia el formulario RAC.",
  "icons": {
    "16": "ceprunsa_ico.png",
    "32": "ceprunsa_ico.png",
    "48": "ceprunsa_ico.png",
    "128": "ceprunsa_ico.png"
  },
  "permissions": ["storage", "alarms"],
  "action": { "default_title": "RAC Gmail — Desarrollo local" },
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail-adapter.js", "content/gmail-content.js"],
      "css": ["content/gmail.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:4000/*"],
      "js": ["content/rac-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
